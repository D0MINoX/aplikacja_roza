<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mauiapp1="clr-namespace:MauiApp1"
             x:Class="MauiApp1.Views.MyRosariesListPage"
             Title="MyRosariesListPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource Primary}">
    
    <Grid RowDefinitions="auto,*,auto,auto,auto">
        <Grid ColumnDefinitions="auto,*" Grid.Row="0"  Style="{StaticResource Head}">
            
            <Label Grid.Column="1" Style="{StaticResource HeaderLabel}">
                Lista Róż
            </Label>
        </Grid>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="RosariesContainer"/>
        </ScrollView>

        <Grid Grid.Row="2" ColumnDefinitions="*,*" IsVisible="False" x:Name="SendOptionsGrid">
            <Border Grid.Column="0" Style="{StaticResource NavButton}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="ConfirmSend_Tapped"/>
                </Border.GestureRecognizers>
                <Label InputTransparent="True" Style="{StaticResource OptionLabel}">
                    Zatwierdź wysyłanie
                </Label>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource NavButton}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="SendToAll_Tapped"/>
                </Border.GestureRecognizers>
                <Label InputTransparent="True" Style="{StaticResource OptionLabel}">
                    Wyślij do wszystkich grup
                </Label>
            </Border>
        </Grid>

        <Border Grid.Row="3" x:Name="SendMessage" Style="{StaticResource NavButton}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="Send_Tapped"/>
            </Border.GestureRecognizers>
            <Label InputTransparent="True" Style="{StaticResource OptionLabel}">
                Wyślij wiadomość do wielu grup
            </Label>
        </Border>

        <mauiapp1:BottomMenu Grid.Row="4"></mauiapp1:BottomMenu>
    </Grid>
    
</ContentPage>