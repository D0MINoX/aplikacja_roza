<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mauiapp1="clr-namespace:MauiApp1"
             xmlns:controls="clr-namespace:MauiApp1.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="MauiApp1.LoginPage"
             Title="LoginPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource Primary}">

    <Grid RowDefinitions="*,auto">
        <ScrollView Grid.Row="0">
            <Grid RowDefinitions="auto,*"  RowSpacing="20">
                <!-- Header -->

                <Grid ColumnDefinitions="auto,*" Grid.Row="0" Grid.Column="1" Style="{StaticResource Head}">
                    <Image Grid.Column="0" Grid.Row="0"
                            Source="back_arrow.png" 
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            Margin="10,0,10,0"
                            HeightRequest="24" WidthRequest="24">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="BackButton_Tapped" />
                        </Image.GestureRecognizers>
                    </Image>
                    <Label Grid.Column="1" Style="{StaticResource HeaderLabel}">
                        Panel logowania
                    </Label>
                </Grid>

                <!-- Panel z logowaniem -->
                <Border Grid.Row="1" Style="{StaticResource MenuOption}" VerticalOptions="Center">
                    <VerticalStackLayout Spacing="15">
                        <Label Text="Zaloguj się" 
                           Style="{StaticResource HeaderLabel}" 
                           HorizontalOptions="Center"/>

                        <controls:MyEntry x:Name="EmailEntry" 
                                      Placeholder="Email" 
                                      Keyboard="Email"/>

                        <controls:MyEntry x:Name="PasswordEntry" 
                                      Placeholder="Hasło" 
                                      IsPassword="True"/>

                        <Border Style="{StaticResource NavButton}" HeightRequest="50" WidthRequest="250">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLoginClicked"/>
                            </Border.GestureRecognizers>
                            <Label InputTransparent="True" Style="{StaticResource OptionLabel}">
                                ZALOGUJ SIĘ
                            </Label>
                        </Border>

                        <Border Style="{StaticResource NavButton}" HeightRequest="50" WidthRequest="250">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRegisterClicked"/>
                            </Border.GestureRecognizers>
                            <Label InputTransparent="True" Style="{StaticResource OptionLabel}">
                                ZAREJESTRUJ SIĘ
                            </Label>
                        </Border>

                    </VerticalStackLayout>
                </Border>
            </Grid>
        </ScrollView>
        <mauiapp1:BottomMenu Grid.Row="1"/>
    </Grid>
    
</ContentPage>