<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.RegisterPage"
             xmlns:mauiapp1="clr-namespace:MauiApp1" xmlns:controls="clr-namespace:MauiApp1.Controls"
             Title="RegisterPage"
             Background="{DynamicResource Primary}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="20">

                <!-- Header -->
                <Grid ColumnDefinitions="auto,*" Grid.Row="0" Grid.Column="1" Style="{StaticResource Head}">
                    <Image Grid.Column="0" Grid.Row="0"
                            Source="back_arrow.png" 
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            Margin="10,0,10,0"
                            HeightRequest="24" WidthRequest="24">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="BackButton_Tapped" />
                        </Image.GestureRecognizers>
                    </Image>
                    <Label Grid.Column="1" Style="{StaticResource HeaderLabel}">
                        Panel Rejestracji
                    </Label>
                </Grid>

                <Border Style="{StaticResource MenuOption}">
                    <VerticalStackLayout Spacing="5">

                        <Label Text="Zarejestruj się"
                               Style="{StaticResource HeaderLabel}"
                               HorizontalOptions="Center"/>

                        <controls:MyEntry x:Name="NameEntry"
                                          Placeholder="Imię"/>

                        <controls:MyEntry x:Name="SurnameEntry"
                                          Placeholder="Nazwisko"/>

                        <controls:MyEntry x:Name="EmailEntry"
                                          Placeholder="Email"
                                          Keyboard="Email"/>

                        <controls:MyEntry x:Name="PasswordEntry"
                                          Placeholder="Hasło"
                                          IsPassword="True"/>

                        <controls:MyEntry x:Name="PasswordRetype"
                                          Placeholder="Powtórz Hasło"
                                          IsPassword="True"/>

                        <Border BackgroundColor="{DynamicResource Primary}" HeightRequest="45" Padding="3">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ParishTapped"/>
                            </Border.GestureRecognizers>
                            <VerticalStackLayout>
                                <Label x:Name="ParishLabel" Text="Wybierz Swoją parafie" Margin="0,7"/>
                                <BoxView BackgroundColor="{StaticResource FadedText}" />
                            </VerticalStackLayout>
                        </Border>

                        <Label Text="Jeśli nie widzisz swojej parafii, możesz ją pominąć." Style="{StaticResource HeaderLabel2}"/>
                        
                        <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                            <CheckBox x:Name="AcceptTermsCheckBox" Color="{DynamicResource Text}"/>
                            <Label VerticalOptions="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        
                                        <Span Text="Akceptuję " />

                                        <Span Text="Regulamin"
                                              TextColor="{DynamicResource Tertiary}" 
                                              TextDecorations="Underline">
                                            <Span.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OpenRegulamin_Tapped" />
                                            </Span.GestureRecognizers>
                                        </Span>

                                        <Span Text=" oraz " />

                                        <Span Text="Politykę Prywatności"
                                              TextColor="{DynamicResource Tertiary}"
                                              TextDecorations="Underline">
                                            <Span.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OpenPrywatnosc_Tapped" />
                                            </Span.GestureRecognizers>
                                        </Span>
                                        <Span Text="*" TextColor="red"/>
                                        
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </HorizontalStackLayout>
                        
                        <Border Style="{StaticResource NavButton}" HeightRequest="50" WidthRequest="250">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Register_Clicked"/>
                            </Border.GestureRecognizers>
                            <Label InputTransparent="True" Style="{StaticResource OptionLabel}">
                                ZAREJESTRUJ SIĘ
                            </Label>
                        </Border>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <mauiapp1:BottomMenu Grid.Row="1" />
    </Grid>
</ContentPage>
