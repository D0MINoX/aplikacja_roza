<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mauiapp1="clr-namespace:MauiApp1"
             xmlns:controls="clr-namespace:MauiApp1.Controls"
             x:Class="MauiApp1.Views.ReportBugPage"
             Title="ReportBugPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{DynamicResource Primary}">
    
    <Grid RowDefinitions="*,auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="20">

                <Grid ColumnDefinitions="auto,*" Grid.Row="0" Grid.Column="1" Style="{StaticResource Head}">
                    <Image Grid.Column="0" Grid.Row="0"
                        Source="back_arrow.png" 
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Margin="10,0,10,0"
                        HeightRequest="24" WidthRequest="24">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="BackButton_Tapped" />
                        </Image.GestureRecognizers>
                    </Image>
                    <Label Grid.Column="1" Style="{StaticResource HeaderLabel}">
                        Zgłoś błąd
                    </Label>
                </Grid>

                <Border Style="{StaticResource MenuOption}">
                    <Grid RowDefinitions="auto,auto,auto,auto,auto,auto,auto" ColumnSpacing="20">
                        <Label  Grid.Row="0" Text="Prosimy o numer telefonu w razie problemów z znalezieniem błędu" Style="{StaticResource OptionLabel}" HorizontalOptions="Start"/>
                        <controls:MyEntry Placeholder="wpisz swój numer telefonu" Grid.Row="1" x:Name="Phone"/>
                        <Label  Grid.Row="2" Text="Strona na której wystąpił błąd (Napis u góry zakładki):" Style="{StaticResource OptionLabel}" HorizontalOptions="Start"/>
                        <controls:MyEntry Placeholder="wpisz stronę na któej wystąpił błąd" Grid.Row="3" x:Name="PageName"/>
                        <Label Grid.Row="4" Text="Opis błędu:" Style="{StaticResource OptionLabel}" HorizontalOptions="Start"/>

                        <Border Grid.Row="5" StrokeShape="RoundRectangle 5" StrokeThickness="1" Stroke="{DynamicResource Accent}">
                            <controls:MyEditor Placeholder="Wpisz tutaj opis błędu..." AutoSize="TextChanges" x:Name="Description"/>
                        </Border>
                        <Border  Grid.Row="6" Style="{StaticResource NavButton}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="SendReport_Tapped"/>
                            </Border.GestureRecognizers>
                            <Label InputTransparent="True" Style="{StaticResource OptionLabel}">
                                Wyślij
                            </Label>
                        </Border>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
        <mauiapp1:BottomMenu Grid.Row="1"/>
    </Grid>
</ContentPage>